  "sections": [
    {
      "id": "likert",
      "title": "Work Style — Agreement Scale",
      "questions": [
        {
          "id": "gha-01-lk-01",
          "type": "likert",
          "text": "I change my approach when credible feedback reveals a weakness.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "learning": 1
          },
          "consistencyGroup": "learning-2",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-02",
          "type": "likert",
          "text": "I prefer solving cross-team problems within my own team before contacting others.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "collaboration": -1
          },
          "consistencyGroup": "collaboration-3",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-03",
          "type": "likert",
          "text": "I can support a team decision even when another option was my personal preference.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "collaboration": 1
          },
          "consistencyGroup": "collaboration-4",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-04",
          "type": "likert",
          "text": "Changes to a plan are frustrating enough that they often reduce my effectiveness for a while.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "adaptability": -1
          },
          "consistencyGroup": "adaptability-1",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-05",
          "type": "likert",
          "text": "Unexpected requests often cause me to lose track of earlier commitments.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "reliability": -1
          },
          "consistencyGroup": "reliability-2",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-06",
          "type": "likert",
          "text": "I prefer to resolve disagreements by proceeding with my own approach and showing the result.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "collaboration": -1
          },
          "consistencyGroup": "collaboration-3",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-07",
          "type": "likert",
          "text": "I tend to start implementing before I have clearly defined the problem.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "problemSolving": -1
          },
          "consistencyGroup": "problemSolving-4",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-08",
          "type": "likert",
          "text": "I find it difficult to proceed when the decision-maker has not specified exactly what success looks like.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "ambiguityTolerance": -1
          },
          "consistencyGroup": "ambiguityTolerance-1",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-09",
          "type": "likert",
          "text": "When I strongly believe I am right, I have little reason to revisit my view after hearing colleagues.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "collaboration": -1
          },
          "consistencyGroup": "collaboration-2",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-10",
          "type": "likert",
          "text": "Once I have invested heavily in a plan, I prefer to keep it even when priorities change.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "adaptability": -1
          },
          "consistencyGroup": "adaptability-3",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-11",
          "type": "likert",
          "text": "If a shortcut is unlikely to be noticed, I am comfortable using it to save time.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "quality": -1
          },
          "consistencyGroup": "quality-4",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-12",
          "type": "likert",
          "text": "I look for patterns across repeated failures rather than treating each incident independently.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "problemSolving": 1
          },
          "consistencyGroup": "problemSolving-1",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-13",
          "type": "likert",
          "text": "When a solution appears to work, I rarely spend time testing alternative explanations.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "problemSolving": -1
          },
          "consistencyGroup": "problemSolving-2",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-14",
          "type": "likert",
          "text": "When time is short, I tend to rely on people whose opinions I already know.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "inclusion": -1
          },
          "consistencyGroup": "inclusion-3",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-15",
          "type": "likert",
          "text": "Once I become competent at a task, I rarely seek feedback on how I perform it.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "learning": -1
          },
          "consistencyGroup": "learning-4",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-16",
          "type": "likert",
          "text": "I am willing to change my approach when a teammate presents stronger evidence.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "collaboration": 1
          },
          "consistencyGroup": "collaboration-1",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-17",
          "type": "likert",
          "text": "If nobody is harmed, small conflicts of interest do not always need to be disclosed.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "integrity": -1
          },
          "consistencyGroup": "integrity-2",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-18",
          "type": "likert",
          "text": "I am uncomfortable starting until most important details are fully specified.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "ambiguityTolerance": -1
          },
          "consistencyGroup": "ambiguityTolerance-3",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-19",
          "type": "likert",
          "text": "I break complex problems into smaller questions that can be tested.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "problemSolving": 1
          },
          "consistencyGroup": "problemSolving-4",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-20",
          "type": "likert",
          "text": "I actively look for lessons after something does not go as expected.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "learning": 1
          },
          "consistencyGroup": "learning-1",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-21",
          "type": "likert",
          "text": "I can commit to a reasonable path while remaining open to changing it later.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "decisiveness": 1
          },
          "consistencyGroup": "decisiveness-2",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-22",
          "type": "likert",
          "text": "In time-sensitive situations, I prefer decisions to be driven mainly by the people with the most seniority.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "inclusion": -1
          },
          "consistencyGroup": "inclusion-3",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-23",
          "type": "likert",
          "text": "I can remain effective even when a project changes direction more than once.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "adaptability": 1
          },
          "consistencyGroup": "adaptability-4",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-24",
          "type": "likert",
          "text": "I am willing to proceed with a documented assumption when waiting for certainty has greater cost.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "ambiguityTolerance": 1
          },
          "consistencyGroup": "ambiguityTolerance-1",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-25",
          "type": "likert",
          "text": "I make reversible decisions promptly when additional analysis is unlikely to change the choice.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "decisiveness": 1
          },
          "consistencyGroup": "decisiveness-2",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-26",
          "type": "likert",
          "text": "I share difficult information clearly rather than softening it until its meaning is lost.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "communication": 1
          },
          "consistencyGroup": "communication-3",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-27",
          "type": "likert",
          "text": "When a familiar fix solves a problem once, I tend to reuse it without further investigation.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "problemSolving": -1
          },
          "consistencyGroup": "problemSolving-4",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-28",
          "type": "likert",
          "text": "I plan my work so that predictable interruptions do not repeatedly cause missed commitments.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "reliability": 1
          },
          "consistencyGroup": "reliability-1",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-29",
          "type": "likert",
          "text": "I distinguish between harmless imperfections and defects that could create meaningful risk.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "quality": 1
          },
          "consistencyGroup": "quality-2",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-30",
          "type": "likert",
          "text": "I can define useful experiments or next steps even when the final solution is uncertain.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "ambiguityTolerance": 1
          },
          "consistencyGroup": "ambiguityTolerance-3",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-31",
          "type": "likert",
          "text": "Pressure from a senior colleague would not make me comfortable ignoring a required control.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "integrity": 1
          },
          "consistencyGroup": "integrity-4",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-32",
          "type": "likert",
          "text": "I communicate uncertainty directly when others may otherwise mistake an estimate for a fact.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "communication": 1
          },
          "consistencyGroup": "communication-1",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-33",
          "type": "likert",
          "text": "I revisit decisions when new evidence shows that my original reasoning was incomplete.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "learning": 1
          },
          "consistencyGroup": "learning-2",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-34",
          "type": "likert",
          "text": "I make important assumptions explicit when they could affect a decision.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "communication": 1
          },
          "consistencyGroup": "communication-3",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-35",
          "type": "likert",
          "text": "Unclear ownership usually makes me pause until someone assigns responsibilities explicitly.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "ambiguityTolerance": -1
          },
          "consistencyGroup": "ambiguityTolerance-4",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-36",
          "type": "likert",
          "text": "When priorities change, previously agreed commitments often become easy for me to overlook.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "reliability": -1
          },
          "consistencyGroup": "reliability-1",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-37",
          "type": "likert",
          "text": "I try to understand disagreement before assuming someone is being difficult.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "inclusion": 1
          },
          "consistencyGroup": "inclusion-2",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-38",
          "type": "likert",
          "text": "I delay sharing bad news until I have a complete solution.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "communication": -1
          },
          "consistencyGroup": "communication-3",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-39",
          "type": "likert",
          "text": "I know when a decision needs escalation and when I can make it myself.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "decisiveness": 1
          },
          "consistencyGroup": "decisiveness-4",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-40",
          "type": "likert",
          "text": "A rule can be ignored if everyone involved informally agrees it is unnecessary.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "integrity": -1
          },
          "consistencyGroup": "integrity-1",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-41",
          "type": "likert",
          "text": "I prefer roles where priorities remain stable for long periods.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "adaptability": -1
          },
          "consistencyGroup": "adaptability-2",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-42",
          "type": "likert",
          "text": "Under deadline pressure, I am comfortable reducing verification even when the consequences of error are significant.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "quality": -1
          },
          "consistencyGroup": "quality-3",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-43",
          "type": "likert",
          "text": "I often assume others have the same background context that I do.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "communication": -1
          },
          "consistencyGroup": "communication-4",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-44",
          "type": "likert",
          "text": "I often postpone decisions when none of the available choices is clearly best.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "decisiveness": -1
          },
          "consistencyGroup": "decisiveness-1",
          "analysis": {
            "polarity": -1
          }
        },
        {
          "id": "gha-01-lk-45",
          "type": "likert",
          "text": "I share context that could help teammates make better decisions.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "collaboration": 1
          },
          "consistencyGroup": "collaboration-2",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-46",
          "type": "likert",
          "text": "I seek input from people who will be affected by a decision when their perspective could improve it.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "collaboration": 1
          },
          "consistencyGroup": "collaboration-3",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-47",
          "type": "likert",
          "text": "I can preserve useful work from an old plan while moving decisively to a new one.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "adaptability": 1
          },
          "consistencyGroup": "adaptability-4",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-48",
          "type": "likert",
          "text": "When I see a problem that could affect the team's outcome, I act rather than waiting for someone to assign it to me.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "ownership": 1
          },
          "consistencyGroup": "ownership-1",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-49",
          "type": "likert",
          "text": "I can re-prioritize quickly when new information changes what matters most.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "adaptability": 1
          },
          "consistencyGroup": "adaptability-2",
          "analysis": {
            "polarity": 1
          }
        },
        {
          "id": "gha-01-lk-50",
          "type": "likert",
          "text": "If a policy seems inefficient in a specific case, I am comfortable making an unofficial exception.",
          "options": [
            "Strongly Disagree",
            "Disagree",
            "Neutral",
            "Agree",
            "Strongly Agree"
          ],
          "traits": {
            "integrity": -1
          },
